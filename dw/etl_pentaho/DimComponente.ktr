    <sql>SET GLOBAL SQL_MODE = "NO_AUTO_VALUE_ON_ZERO"; -- permite a inserção do valor zero na chave autoincremento

INSERT INTO `dim_componente` (`sk_componente`,`codigo_componente`,`nome_componente`,`grupo_financeiro`,`papel_analitico`,`natureza_valor`,`regra_temporal`,`exige_esfera`,`tabela_origem`,`regra_agregacao`,`date_from`,`date_to`,`version`)
VALUES (0,'SEM_COMPONENTE','Sem Componente','N/A','N/A','N/A','N/A',0,'N/A','N/A','1970-01-01 00:00:01','2038-01-01 00:00:00',1);</sql>
