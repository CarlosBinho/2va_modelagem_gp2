  <step>
    <name>componente</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>dbSNIS</connection>
    <sql>-- Dimensão Componente: as 30 rubricas financeiras das tabelas receita_arrecadacao,
-- despesa_operacional e investimento_saneamento (catálogo 03_CATALOGO_COMPONENTES.csv)
SELECT 'receita_operacional' AS codigo_componente, 'Receita operacional total' AS nome_componente, 'RECEITAS' AS grupo_financeiro, 'TOTAL_REFERENCIA' AS papel_analitico, 'VALOR_ANUAL' AS natureza_valor, 'ACUMULADO_NOMINAL' AS regra_temporal, 0 AS exige_esfera, 'receita_arrecadacao' AS tabela_origem, 'Somar a mesma rubrica entre municipios/anos compativeis; nao somar totais com suas parcelas nem origens com destinos do investimento.' AS regra_agregacao
UNION ALL SELECT 'receita_operacional_direta', 'Receita operacional direta', 'RECEITAS', 'SUBTOTAL_REFERENCIA', 'VALOR_ANUAL', 'ACUMULADO_NOMINAL', 0, 'receita_arrecadacao', 'Somar a mesma rubrica entre municipios/anos compativeis; nao somar totais com suas parcelas nem origens com destinos do investimento.'
