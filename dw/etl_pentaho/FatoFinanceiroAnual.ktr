    <connection>dbSNIS</connection>
    <sql>-- Atributos da Tabela Fato Financeiro Anual (11):
-- 6 FK: sk_localidade, sk_tempo, sk_componente, sk_esfera, sk_porte_municipio, sk_faixa_valor (int)
-- 5 métricas: valor_informado_rs, valor_informado_rs_milhares, valor_absoluto_rs,
--             quantidade_registros, quantidade_valores_positivos
-- Grão: 1 montante efetivamente informado por município x ano x componente x esfera
-- (as 46 colunas monetárias são transformadas em linhas; valores NULL não geram linha)

SELECT COALESCE(m.codigo_ibge, '0000000') AS idlocalidade,
COALESCE(x.ano, 0) AS idtempo,
COALESCE(x.componente, 'SEM_COMPONENTE') AS idcomponente,
COALESCE(x.esfera, 'SEM_ESFERA') AS idesfera,
CASE WHEN ms.populacao_urbana IS NULL THEN 'NAO_INFORMADO'
     WHEN ms.populacao_urbana &lt;= 20000 THEN 'PEQUENO'
     WHEN ms.populacao_urbana &lt;= 100000 THEN 'MEDIO'
     WHEN ms.populacao_urbana &lt;= 900000 THEN 'GRANDE'
     ELSE 'METROPOLE' END AS idporte,
CASE WHEN x.valor &lt; 0 THEN 'VALOR_NEGATIVO'
     WHEN x.valor = 0 THEN 'VALOR_ZERADO'
     WHEN x.valor &lt;= 100000 THEN 'FAIXA_ATE_100K'
     WHEN x.valor &lt;= 1000000 THEN 'FAIXA_100K_1M'
     WHEN x.valor &lt;= 10000000 THEN 'FAIXA_1M_10M'
     ELSE 'FAIXA_ACIMA_10M' END AS idfaixa,
x.valor AS valor_informado,
x.valor / 1000 AS valor_milhares,
ABS(x.valor) AS valor_absoluto,
1 AS registros,
CASE WHEN x.valor &gt; 0 THEN 1 ELSE 0 END AS positivos
FROM (
    SELECT id_municipio, ano, 'receita_operacional' AS componente, 'NAO_SE_APLICA' AS esfera, receita_operacional AS valor FROM receita_arrecadacao WHERE receita_operacional IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'receita_operacional_direta' AS componente, 'NAO_SE_APLICA' AS esfera, receita_operacional_direta AS valor FROM receita_arrecadacao WHERE receita_operacional_direta IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'receita_operacional_direta_agua' AS componente, 'NAO_SE_APLICA' AS esfera, receita_operacional_direta_agua AS valor FROM receita_arrecadacao WHERE receita_operacional_direta_agua IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'receita_operacional_direta_esgoto' AS componente, 'NAO_SE_APLICA' AS esfera, receita_operacional_direta_esgoto AS valor FROM receita_arrecadacao WHERE receita_operacional_direta_esgoto IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'receita_operacional_indireta' AS componente, 'NAO_SE_APLICA' AS esfera, receita_operacional_indireta AS valor FROM receita_arrecadacao WHERE receita_operacional_indireta IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'receita_operacional_direta_agua_exportada' AS componente, 'NAO_SE_APLICA' AS esfera, receita_operacional_direta_agua_exportada AS valor FROM receita_arrecadacao WHERE receita_operacional_direta_agua_exportada IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'receita_operacional_direta_esgoto_importado' AS componente, 'NAO_SE_APLICA' AS esfera, receita_operacional_direta_esgoto_importado AS valor FROM receita_arrecadacao WHERE receita_operacional_direta_esgoto_importado IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'arrecadacao_total' AS componente, 'NAO_SE_APLICA' AS esfera, arrecadacao_total AS valor FROM receita_arrecadacao WHERE arrecadacao_total IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'credito_a_receber' AS componente, 'NAO_SE_APLICA' AS esfera, credito_a_receber AS valor FROM receita_arrecadacao WHERE credito_a_receber IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_total_servico', 'NAO_SE_APLICA', despesa_total_servico FROM despesa_operacional WHERE despesa_total_servico IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_exploracao', 'NAO_SE_APLICA', despesa_exploracao FROM despesa_operacional WHERE despesa_exploracao IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_pessoal', 'NAO_SE_APLICA', despesa_pessoal FROM despesa_operacional WHERE despesa_pessoal IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_energia', 'NAO_SE_APLICA', despesa_energia FROM despesa_operacional WHERE despesa_energia IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_produto_quimico', 'NAO_SE_APLICA', despesa_produto_quimico FROM despesa_operacional WHERE despesa_produto_quimico IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_servico_terceiro', 'NAO_SE_APLICA', despesa_servico_terceiro FROM despesa_operacional WHERE despesa_servico_terceiro IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_ativo', 'NAO_SE_APLICA', despesa_ativo FROM despesa_operacional WHERE despesa_ativo IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_agua_importada', 'NAO_SE_APLICA', despesa_agua_importada FROM despesa_operacional WHERE despesa_agua_importada IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_esgoto_exportado', 'NAO_SE_APLICA', despesa_esgoto_exportado FROM despesa_operacional WHERE despesa_esgoto_exportado IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_fiscal', 'NAO_SE_APLICA', despesa_fiscal FROM despesa_operacional WHERE despesa_fiscal IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_fiscal_nao_computada', 'NAO_SE_APLICA', despesa_fiscal_nao_computada FROM despesa_operacional WHERE despesa_fiscal_nao_computada IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_exploracao_outro', 'NAO_SE_APLICA', despesa_exploracao_outro FROM despesa_operacional WHERE despesa_exploracao_outro IS NOT NULL
    UNION ALL SELECT id_municipio, ano, 'despesa_servico_outro', 'NAO_SE_APLICA', despesa_servico_outro FROM despesa_operacional WHERE despesa_servico_outro IS NOT NULL
    UNION ALL SELECT i.id_municipio, i.ano, 'despesa_capitalizavel', UPPER(e.codigo_esfera), i.despesa_capitalizavel FROM investimento_saneamento i INNER JOIN tipo_esfera e ON e.id_esfera = i.id_esfera WHERE i.despesa_capitalizavel IS NOT NULL
    UNION ALL SELECT i.id_municipio, i.ano, 'investimento_agua', UPPER(e.codigo_esfera), i.investimento_agua FROM investimento_saneamento i INNER JOIN tipo_esfera e ON e.id_esfera = i.id_esfera WHERE i.investimento_agua IS NOT NULL
    UNION ALL SELECT i.id_municipio, i.ano, 'investimento_esgoto', UPPER(e.codigo_esfera), i.investimento_esgoto FROM investimento_saneamento i INNER JOIN tipo_esfera e ON e.id_esfera = i.id_esfera WHERE i.investimento_esgoto IS NOT NULL
    UNION ALL SELECT i.id_municipio, i.ano, 'investimento_outro', UPPER(e.codigo_esfera), i.investimento_outro FROM investimento_saneamento i INNER JOIN tipo_esfera e ON e.id_esfera = i.id_esfera WHERE i.investimento_outro IS NOT NULL
    UNION ALL SELECT i.id_municipio, i.ano, 'investimento_recurso_proprio', UPPER(e.codigo_esfera), i.investimento_recurso_proprio FROM investimento_saneamento i INNER JOIN tipo_esfera e ON e.id_esfera = i.id_esfera WHERE i.investimento_recurso_proprio IS NOT NULL
    UNION ALL SELECT i.id_municipio, i.ano, 'investimento_recurso_oneroso', UPPER(e.codigo_esfera), i.investimento_recurso_oneroso FROM investimento_saneamento i INNER JOIN tipo_esfera e ON e.id_esfera = i.id_esfera WHERE i.investimento_recurso_oneroso IS NOT NULL
    UNION ALL SELECT i.id_municipio, i.ano, 'investimento_recurso_nao_oneroso', UPPER(e.codigo_esfera), i.investimento_recurso_nao_oneroso FROM investimento_saneamento i INNER JOIN tipo_esfera e ON e.id_esfera = i.id_esfera WHERE i.investimento_recurso_nao_oneroso IS NOT NULL
    UNION ALL SELECT i.id_municipio, i.ano, 'investimento_total', UPPER(e.codigo_esfera), i.investimento_total FROM investimento_saneamento i INNER JOIN tipo_esfera e ON e.id_esfera = i.id_esfera WHERE i.investimento_total IS NOT NULL
) x
INNER JOIN municipio m ON m.id_municipio = x.id_municipio
LEFT JOIN metrica_socioeconomica ms ON ms.id_municipio = x.id_municipio AND ms.ano = x.ano</sql>
    <limit>0</limit>
